generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectMemberRole {
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectStatus {
  IN_PROGRESS
  PAUSED
  DONE
  ARCHIVED
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  PAUSED
  DONE
  CANCELED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProgressEventType {
  CREATED
  STATUS_CHANGED
  PROGRESS_UPDATED
  NOTE
  COMPLETED
  REOPENED
}

enum BlockerStatus {
  OPEN
  INVESTIGATING
  WAITING
  RESOLVED
  CLOSED
}

enum BlockerSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockerEventType {
  CREATED
  STATUS_CHANGED
  COMMENT
  OWNER_CHANGED
  RESOLVED
  REOPENED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?   @db.VarChar(100)
  passwordHash  String?   @map("password_hash") @db.Text
  email         String?   @unique @db.VarChar(255)
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(3)
  image         String?

  accounts  Account[]
  sessions  Session[]
  memberships WorkspaceMember[]

  createdWorkspaces Workspace[] @relation("WorkspaceCreator")
  createdProjects   Project[]   @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  createdTodos      Todo[]      @relation("TodoCreator")
  updatedTodos      Todo[]      @relation("TodoUpdater")

  todoAssignments TodoAssignee[]
  assignedTasks   TodoAssignee[] @relation("TodoAssignedBy")

  progressLogs TodoProgressLog[]
  dailyPlans   TodoDailyPlan[] @relation("DailyPlanCreator")

  reportedBlockers Blocker[] @relation("BlockerReporter")
  ownedBlockers    Blocker[] @relation("BlockerOwner")
  blockerEvents    BlockerEvent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Workspace {
  id          String @id @default(uuid()) @db.Uuid
  name        String @db.VarChar(100)
  description String? @db.Text
  timezone    String @default("Asia/Taipei") @db.VarChar(64)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("WorkspaceCreator", fields: [createdById], references: [id])

  members  WorkspaceMember[]
  projects Project[]
  todos    Todo[]
  blockers Blocker[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String @map("workspace_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  name        String        @db.VarChar(150)
  description String?       @db.Text
  color       String?       @db.VarChar(20)
  status      ProjectStatus @default(IN_PROGRESS)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  todos     Todo[]
  members   ProjectMember[]

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, workspaceId])
  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("projects")
}

model Todo {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  projectId   String? @map("project_id") @db.Uuid

  title       String  @db.VarChar(200)
  description String? @db.Text
  status      TodoStatus @default(TODO)
  priority    Priority   @default(NORMAL)

  currentProgressTitle String? @map("current_progress_title") @db.VarChar(200)
  currentProgressNote  String? @map("current_progress_note") @db.Text

  startAt DateTime? @map("start_at") @db.Timestamptz(3)
  dueAt   DateTime? @map("due_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdById String  @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  createdBy User  @relation("TodoCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("TodoUpdater", fields: [updatedById], references: [id])

  assignees    TodoAssignee[]
  dailyPlans   TodoDailyPlan[]
  progressLogs TodoProgressLog[]
  blockerLinks BlockerTodo[]

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, projectId])
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([workspaceId, dueAt])
  @@map("todos")
}

model TodoAssignee {
  todoId       String @map("todo_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid
  assignedById String @map("assigned_by_id") @db.Uuid

  todo       Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User @relation("TodoAssignedBy", fields: [assignedById], references: [id])

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  @@id([todoId, userId])
  @@index([userId, todoId])
  @@map("todo_assignees")
}

model TodoDailyPlan {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  todoId      String @map("todo_id") @db.Uuid

  planDate       DateTime @map("plan_date") @db.Date
  planNote       String?  @map("plan_note") @db.Text
  actualNote     String?  @map("actual_note") @db.Text
  dayNote        String?  @map("day_note") @db.Text
  plannedMinutes Int?     @map("planned_minutes")
  actualMinutes  Int?     @map("actual_minutes")

  todo Todo @relation(fields: [todoId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  creatorId String @map("created_by_id") @db.Uuid
  creator   User   @relation("DailyPlanCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([todoId, planDate])
  @@index([workspaceId, planDate])
  @@map("todo_daily_plans")
}

model TodoProgressLog {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  todoId      String @map("todo_id") @db.Uuid
  authorId    String @map("author_id") @db.Uuid

  eventType ProgressEventType
  fromStatus TodoStatus? @map("from_status")
  toStatus   TodoStatus? @map("to_status")

  progressTitle String? @map("progress_title") @db.VarChar(200)
  progressNote  String? @map("progress_note") @db.Text
  metadata      Json?   @db.JsonB

  todo Todo @relation(fields: [todoId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([todoId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("todo_progress_logs")
}

model Blocker {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  title       String @db.VarChar(200)
  description String? @db.Text
  cause       String? @db.Text
  impact      String? @db.Text

  severity BlockerSeverity @default(MEDIUM)
  status   BlockerStatus   @default(OPEN)

  reportedById String  @map("reported_by_id") @db.Uuid
  ownerId      String? @map("owner_id") @db.Uuid

  reportedBy User  @relation("BlockerReporter", fields: [reportedById], references: [id])
  owner      User? @relation("BlockerOwner", fields: [ownerId], references: [id])

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  todoLinks BlockerTodo[]
  events    BlockerEvent[]

  detectedAt DateTime  @default(now()) @map("detected_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, severity])
  @@map("blockers")
}

model BlockerTodo {
  workspaceId String @map("workspace_id") @db.Uuid
  blockerId   String @map("blocker_id") @db.Uuid
  todoId      String @map("todo_id") @db.Uuid

  blocker Blocker @relation(fields: [blockerId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  todo    Todo    @relation(fields: [todoId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([blockerId, todoId])
  @@index([todoId])
  @@index([workspaceId])
  @@map("blocker_todos")
}

model BlockerEvent {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  blockerId   String @map("blocker_id") @db.Uuid
  actorId     String @map("actor_id") @db.Uuid

  eventType  BlockerEventType
  fromStatus BlockerStatus? @map("from_status")
  toStatus   BlockerStatus? @map("to_status")
  content    String? @db.Text

  blocker Blocker @relation(fields: [blockerId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  actor   User    @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([blockerId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("blocker_events")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ProjectMember {
  projectId String @map("project_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  role      ProjectMemberRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}
